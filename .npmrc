# Make the `engines` field in package.json binding rather than advisory.
#
# `npm run verify`, `verify:full` and `test` pass --experimental-strip-types
# (they import src/lib/seo/constants.ts), which requires Node 22.6+. On an older
# Node they do not report defects — they exit non-zero with
# "bad option: --experimental-strip-types" before running a single check.
#
# That failure is indistinguishable, to the pipeline, from a site that fails the
# checks: the Step 8 SEO loop's exit condition requires `npm run verify` to have
# exited 0, so an un-runnable verifier makes it unsatisfiable and the loop burns
# every iteration it is allowed, then fails the publish gate.
#
# Without this, `engines` only prints a warning during install.
engine-strict=true

# No vulnerability report during install.
#
# `npm ci` ends by asking the registry for advisories. When any package in the
# tree has one, npm then downloads that package's whole version history to work
# out a fix: measured on this template with one moderate advisory in ESLint's
# tree, about 80 MB of metadata and 60 of the 75 seconds a cold install took
# (16 s with this setting). Nobody reads that report. Every install here is
# automated (Vercel, the editing agent, the Dependabot build), and security
# updates arrive as Dependabot pull requests, which is the path that acts on
# them. `npm audit` still works when run by hand.
audit=false
fund=false
