# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sales / outreach (private, per-project — generated by /sales-brief)
SALES_BRIEF.md

# The owner's intake from britesite.dk/start and the private file made from it: contact details and
# Order data. They belong outside the site (plugin/references/intake/intake-step.md); this is the
# backstop in case one is dropped here, because the repo becomes public at signing with its history.
intake*.json
PRIVATE*.md

# setup-website.sh state (generated per-project, contains local config)
.setup-state
.setup-copy-done
.setup-contact-done
.setup-provision-done

# offboard-website.sh output (archive, Vercel claim link, client handover) — the
# operator's, never the site's
offboard-*/
HANDOVER-*.md

# browser-qa screenshots — regenerated each run, binaries we don't want to track
# (the rest of .redesign-state/ stays committed for pipeline resumption)
# The unattended runner's raw event stream: 36 MB on an 18-route run and written
# continuously, so committing it at each step boundary put hundreds of MB into a
# site's history — cloned by the editing agent on every checkout. run.log is the
# rendered, human-readable record and stays; this is what it was rendered from.
.redesign-state/run.jsonl
.redesign-state/run-*.jsonl
.redesign-state/run-*.log
# Per-route build sandboxes: working copies of the site, one per route, created by
# route-sandbox.mjs and merged back by `collect`. Pure scratch — the code that
# makes them already excludes them from the copy — but nothing stopped git
# tracking them, so a single 18-route run committed 3,353 files and 182 MB into
# the site's history, which the editing agent then clones on every checkout.
.redesign-state/sandboxes/
.redesign-state/screenshots/
.redesign-state/walk.json
# /replicate's reference renders: four widths plus folds per page, 383 MB for an
# 81-page site. Regenerable from the crawl (site-capture.mjs extract --all), and
# only the R4-R6 compares read them; resumption reads the crawl manifest.
.redesign-state/reference/

# Playwright MCP server session data, written into the site root by the review lanes
.playwright-mcp/
